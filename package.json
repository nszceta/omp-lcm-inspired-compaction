{
  "name": "omp-lcm-inspired-compaction",
  "version": "0.1.0",
  "description": "Artifact-backed hierarchical LCM-inspired compaction for Oh My Pi",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": "./src/index.ts",
  "scripts": {
    "test": "bun test",
    "test:omp-profile": "bun test test/omp-profile.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write .",
    "pack": "bun pm pack"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "settings": {
      "renderer": {
        "type": "enum",
        "description": "LCM root renderer",
        "values": [
          "auto",
          "context-full",
          "snapcompact"
        ],
        "default": "auto"
      }
    }
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "17.1.8",
    "@oh-my-pi/snapcompact": "17.1.8"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@oh-my-pi/pi-agent-core": "17.1.8",
    "@oh-my-pi/pi-coding-agent": "17.1.8",
    "@types/bun": "^1.2.20",
    "typescript": "^5.8.3"
  }
}
